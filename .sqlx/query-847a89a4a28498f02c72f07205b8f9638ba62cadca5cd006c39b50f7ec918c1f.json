{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT id, result_id, note, progress, created_at\n        FROM accountability_status_update\n        WHERE result_id = $1\n          AND ($2::timestamptz IS NULL OR (created_at, id) < ($2, $3::uuid))\n        ORDER BY created_at DESC, id DESC\n        LIMIT $4\n        ",

{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT id, org_id, proposal_id, parent_id, author_id, body, depth, status, created_at\n        FROM comment\n        WHERE org_id = $1\n          AND proposal_id = $2\n          AND ($3::timestamptz IS NULL OR (created_at, id) > ($3, $4::uuid))\n        ORDER BY created_at ASC, id ASC\n        LIMIT $5\n        ",

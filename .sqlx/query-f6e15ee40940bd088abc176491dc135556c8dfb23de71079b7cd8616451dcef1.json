  "db_name": "PostgreSQL",
  "query": "\n        SELECT id, office, display_name, public_email, is_candidate, onboarded_at,\n               party, uf, house, avatar_object_key, sphere\n        FROM mandate\n        WHERE org_id = $1\n          AND ($2::text IS NULL OR sphere = $2)\n        ORDER BY display_name ASC\n        LIMIT $3 OFFSET $4\n        ",

  "query": "\n        SELECT id, assembly_id, citizen_id, role, joined_at\n        FROM assembly_member\n        WHERE assembly_id = $1\n          AND ($2::uuid IS NULL OR id > $2)\n        ORDER BY id ASC\n        LIMIT $3\n        ",

{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT id, mandate_id, verification_level, evidence_ref, verified_at\n        FROM mandate_identity_binding\n        WHERE mandate_id = $1\n          AND ($2::timestamptz IS NULL OR (verified_at, id) < ($2, $3))\n        ORDER BY verified_at DESC, id DESC\n        LIMIT $4\n        ",

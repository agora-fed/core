  "query": "\n        UPDATE process\n        SET title = COALESCE($3::text, title),\n            status = COALESCE($4::text, status)\n        WHERE org_id = $1 AND id = $2\n        RETURNING id, org_id, slug, title, status, starts_at, ends_at, created_at\n        ",

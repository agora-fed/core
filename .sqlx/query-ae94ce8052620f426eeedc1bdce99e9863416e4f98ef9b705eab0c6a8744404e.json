  "query": "\n        SELECT id, org_id, target_kind, target_id, rule_id, outcome, created_at\n        FROM moderation_decision\n        WHERE org_id = $1\n          AND ($2::timestamptz IS NULL OR (created_at, id) < ($2, $3::uuid))\n        ORDER BY created_at DESC, id DESC\n        LIMIT $4\n        ",

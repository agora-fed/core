  "db_name": "PostgreSQL",
  "query": "\n        SELECT id, org_id, mandate_id, answered, ignored, created_at, updated_at\n        FROM scorecard\n        WHERE org_id = $1\n          AND ($2::timestamptz IS NULL OR (created_at, id) < ($2, $3::uuid))\n        ORDER BY created_at DESC, id DESC\n        LIMIT $4\n        ",

  "query": "\n        SELECT id, old_level, new_level, changed_at\n        FROM auth_verification_level\n        WHERE citizen_id = $1\n          AND ($2::timestamptz IS NULL OR (changed_at, id) < ($2, $3))\n        ORDER BY changed_at DESC, id DESC\n        LIMIT $4\n        ",

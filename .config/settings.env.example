# Copy to .config/settings.env (gitignored) and fill in. NEVER commit real values.
# PLAN.md principle 8 — secrets only here.

# --- Instance identity (federated branding) ---
# PUBLIC_ORIGIN is the canonical URL for ActivityPub actor IDs — permanent, set before first boot.
PUBLIC_ORIGIN=https://your-instance.example.org
# PUBLIC_SITE_NAME is the build-time default shown in <title>, OG tags, and SSR.
# A name saved in the admin console (admin_branding) takes precedence, including for crawlers:
# the gateway rewrites <title> and the social-card metas when serving each page.
PUBLIC_SITE_NAME=AGORA
# Optional: trailing part of the name in the accent color, and a footer sentence.
# PUBLIC_SITE_NAME_ACCENT=
# PUBLIC_SITE_MOTTO=
# PUBLIC_FORUMS_DESCRIPTION=
# --- Analytics (opt-in; omit both to disable) ---
# PUBLIC_ANALYTICS_DOMAIN=your-instance.example.org
# PUBLIC_ANALYTICS_URL=https://plausible.example.org/js/script.js

# --- Database (IPv6-first; PLAN.md principle 4) ---
DATABASE_URL=postgres://dsoc@[::1]:5432/democracia_social
# --- Cache / realtime ---
REDIS_URL=redis://[::1]:6379
# --- Sovereign identity (Zitadel OIDC) ---
OIDC_ISSUER=https://id.pop.coop
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# --- Contributions from other servers to public federated forums (off unless true) ---
# FORUM_INBOUND_ENABLED=true
# Hosts whose accounts skip the approval queue, comma-separated. Everyone else waits for an admin.
# FORUM_INBOUND_TRUSTED_HOSTS=
# Per-minute caps (defaults shown).
# FORUM_INBOUND_PER_ACTOR_PER_MIN=30
# FORUM_INBOUND_PER_HOST_PER_MIN=300
# Most items one server, and one forum, may have waiting (defaults shown). Past that they are dropped.
# FORUM_INBOUND_MAX_PENDING_PER_HOST=20
# FORUM_INBOUND_MAX_PENDING_PER_FORUM=100
# --- Forgejo automation (CI / repo ops) ---
FORGEJO_BASE_URL=https://git.pop.coop
FORGEJO_TOKEN=
# --- Notifications ---
# SMTP is read as discrete vars by `auth::password_reset` (and, later, mandate invite +
# SLA notifications). SMTP_HOST + SMTP_FROM are required; without them the service falls
# back to DEV mode (logs the URL instead of sending — see the tracing::warn in from_state).
# Port 587 → STARTTLS; port 465 → implicit TLS. SMTP_USER/SMTP_PASS trigger auth only when
# both are present.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=AGORA <sistema@example.org>
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
# --- Embeddings (local model on LXC; no external API for civic content) ---
EMBEDDINGS_URL=http://[::1]:8081

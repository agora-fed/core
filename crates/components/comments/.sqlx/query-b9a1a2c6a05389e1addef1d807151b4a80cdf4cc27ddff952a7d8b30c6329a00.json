  "query": "\n        INSERT INTO comment_vote (id, comment_id, citizen_id, weight, created_at)\n        VALUES ($1, $2, $3, $4, $5)\n        ON CONFLICT (comment_id, citizen_id)\n        DO UPDATE SET weight = EXCLUDED.weight\n        RETURNING id, comment_id, citizen_id, weight, created_at\n        ",

{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT id, scorecard_id, text, made_at, delivered, delivered_at, created_at\n        FROM scorecard_promise\n        WHERE scorecard_id = $1\n          AND ($2::timestamptz IS NULL OR (made_at, id) < ($2, $3::uuid))\n        ORDER BY made_at DESC, id DESC\n        LIMIT $4\n        ",

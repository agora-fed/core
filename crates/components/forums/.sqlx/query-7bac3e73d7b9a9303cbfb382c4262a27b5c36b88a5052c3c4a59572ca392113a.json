  "query": "SELECT id, topic_id, author_id, remote_handle, federated, stance, body, created_at\n           FROM forum_topic_comment\n           WHERE topic_id = $1 AND moderation = 'approved'\n             AND ($2::uuid IS NULL OR id > $2)\n           ORDER BY id\n           LIMIT $3",

  "query": "INSERT INTO meeting_attendee (id, meeting_id, citizen_id, created_at)\n           VALUES ($1, $2, $3, $4)\n           ON CONFLICT (meeting_id, citizen_id)\n               DO UPDATE SET meeting_id = EXCLUDED.meeting_id\n           RETURNING id, meeting_id, citizen_id, created_at",

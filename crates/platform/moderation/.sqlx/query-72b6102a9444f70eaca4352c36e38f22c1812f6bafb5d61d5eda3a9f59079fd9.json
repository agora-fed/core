  "db_name": "PostgreSQL",
  "query": "\n        SELECT id, org_id, kind, pattern, action, created_at\n        FROM moderation_rule\n        WHERE org_id = $1\n          AND ($2::timestamptz IS NULL OR (created_at, id) < ($2, $3::uuid))\n        ORDER BY created_at DESC, id DESC\n        LIMIT $4\n        ",

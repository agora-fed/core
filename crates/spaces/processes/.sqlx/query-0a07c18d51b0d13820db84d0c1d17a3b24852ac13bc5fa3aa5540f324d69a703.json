  "query": "\n        SELECT id, org_id, slug, title, status, starts_at, ends_at, created_at\n        FROM process\n        WHERE org_id = $1 AND ($2::uuid IS NULL OR id > $2)\n        ORDER BY id ASC\n        LIMIT $3\n        ",

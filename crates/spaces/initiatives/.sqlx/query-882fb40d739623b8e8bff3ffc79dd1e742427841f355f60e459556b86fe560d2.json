  "query": "\n        SELECT id, org_id, title, body, threshold, signature_count, reached_at, created_at\n        FROM initiative\n        WHERE org_id = $1 AND ($2::uuid IS NULL OR id > $2)\n        ORDER BY id ASC\n        LIMIT $3\n        ",

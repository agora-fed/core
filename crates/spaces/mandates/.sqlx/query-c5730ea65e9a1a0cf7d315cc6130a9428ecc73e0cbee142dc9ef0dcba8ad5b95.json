  "query": "\n        SELECT id, mandate_id, office, district, term_start, term_end, created_at\n        FROM mandate_office\n        WHERE mandate_id = $1\n          AND ($2::uuid IS NULL OR id > $2)\n        ORDER BY id ASC\n        LIMIT $3\n        ",

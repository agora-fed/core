# Public API gateway base URL (IPv6-first). Consumed by src/lib/api.ts.
# Defaults to the live IPv6 gateway when unset.
PUBLIC_API_BASE=http://[2804:710:d0:9::a000]:8080

# Organization id used to scope public list endpoints (proposals, scorecards…).
PUBLIC_ORG_ID=00000000-0000-0000-0000-000000000000

# Canonical site URL for sitemap / Open Graph (build-time only).
SITE=https://democracia.social.br

---
// Site header — collapses into a hamburger drawer on small screens. Consumes
// semantic tokens (--surface-*/--text-*/--accent) so it Just Works in dark
// mode. Political nav only; social/fediverse lives inside AuthMenu.
import AuthMenu from './islands/AuthMenu.svelte';

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);

// Políticos is a dropdown parent: hover on desktop, always-expanded in the
// mobile drawer. The sub-items point at the político-centric dashboards.
const linksBefore: Array<{ href: string; label: string; cta?: boolean }> = [];
const politicosSub = [
  { href: '/politicos/', label: 'Diretório' },
  { href: '/politicos/gastos/', label: 'Gasto Parlamentar' },
  { href: '/politicos/propostas/', label: 'Propostas dos Mandatos' },
];
const linksAfter: Array<{ href: string; label: string; cta?: boolean }> = [
  { href: '/partidos', label: 'Partidos' },
  { href: '/eleicoes/2026', label: 'Eleições 2026' },
  { href: '/propostas', label: 'Propostas' },
  { href: '/propor', label: 'Propor', cta: true },
  { href: '/debates', label: 'Debates' },
  { href: '/consultas', label: 'Consultas' },
];
const politicosActive = path.startsWith('/politicos');
---

<header class="site-header">
  <div class="container bar">
    <a href="/" class="brand" aria-label="DemocraciaBR — página inicial">
      <img
        src="/logo.png"
        width="160"
        height="107"
        alt="DemocraciaBR"
        class="brand-logo"
      />
    </a>

    <input id="menu-toggle" class="menu-toggle" type="checkbox" aria-hidden="true" />
    <label for="menu-toggle" class="menu-button" aria-label="Abrir menu">
      <span class="bars" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
      </span>
    </label>

    <div class="drawer">
      <nav aria-label="Navegação principal" class="nav">
        {
          linksBefore.map((l) => (
            <a
              href={l.href}
              class:list={[
                'nav-link',
                { active: isActive(l.href), cta: l.cta },
              ]}
              aria-current={isActive(l.href) ? 'page' : undefined}
            >
              {l.label}
            </a>
          ))
        }

        {/* Políticos with sub-menu (Diretório · Gasto · Propostas). */}
        <div class="dropdown" class:list={[{ 'is-active': politicosActive }]}>
          <a
            href="/politicos/"
            class:list={['nav-link', { active: politicosActive }]}
            aria-current={politicosActive ? 'page' : undefined}
            aria-haspopup="menu"
          >
            Políticos
            <span class="caret" aria-hidden="true">▾</span>
          </a>
          <div class="dropdown-menu" role="menu">
            {politicosSub.map((s) => (
              <a
                href={s.href}
                class:list={['dropdown-item', { active: path === s.href }]}
                role="menuitem"
                aria-current={path === s.href ? 'page' : undefined}
              >
                {s.label}
              </a>
            ))}
          </div>
        </div>

        {
          linksAfter.map((l) => (
            <a
              href={l.href}
              class:list={[
                'nav-link',
                { active: isActive(l.href), cta: l.cta },
              ]}
              aria-current={isActive(l.href) ? 'page' : undefined}
            >
              {l.label}
            </a>
          ))
        }
      </nav>

      <div class="actions">
        <AuthMenu client:load />
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    background: var(--surface-1);
    border-bottom: 1px solid var(--border-subtle);
    position: sticky;
    top: 0;
    z-index: 50;
    transition: background var(--dur-base) var(--ease-out);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
    min-height: 64px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }
  .brand-logo {
    height: 38px;
    width: auto;
  }

  .menu-toggle,
  .menu-button {
    display: none;
  }

  .drawer {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
    flex: 1;
    justify-content: space-between;
  }
  .nav {
    display: flex;
    gap: var(--sp-1);
    flex-wrap: wrap;
    margin-inline-start: auto;
  }
  .nav-link {
    text-decoration: none;
    color: var(--text-2);
    font-weight: var(--fw-medium);
    padding: var(--sp-2) var(--sp-3);
    border-radius: var(--r-sm);
    font-size: var(--fs-sm);
    transition:
      background var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }
  .nav-link:hover {
    background: var(--surface-2);
    color: var(--text-1);
  }
  .nav-link.active {
    color: var(--accent-strong);
    background: var(--accent-soft);
  }
  .nav-link.cta {
    background: var(--accent);
    color: var(--accent-contrast);
  }
  .nav-link.cta:hover {
    background: var(--accent-strong);
    color: var(--accent-contrast);
    filter: brightness(1.05);
  }
  .nav-link.cta.active {
    background: var(--accent-strong);
    color: var(--accent-contrast);
    box-shadow:
      inset 0 0 0 2px var(--surface-1),
      0 0 0 2px var(--accent-strong);
  }
  .dropdown {
    position: relative;
  }
  .caret {
    font-size: 0.7em;
    margin-left: 2px;
    display: inline-block;
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .dropdown-menu {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 14rem;
    background: var(--surface-1);
    border: 1px solid var(--border-subtle);
    border-radius: var(--r-base);
    box-shadow: var(--shadow-lg);
    padding: var(--sp-1);
    z-index: 60;
    flex-direction: column;
  }
  .dropdown:hover .dropdown-menu,
  .dropdown:focus-within .dropdown-menu {
    display: flex;
  }
  .dropdown:hover .caret,
  .dropdown:focus-within .caret {
    transform: rotate(180deg);
  }
  .dropdown-item {
    display: block;
    padding: var(--sp-2) var(--sp-3);
    border-radius: var(--r-sm);
    text-decoration: none;
    color: var(--text-1);
    font-weight: var(--fw-medium);
    font-size: var(--fs-sm);
    white-space: nowrap;
  }
  .dropdown-item:hover {
    background: var(--surface-2);
  }
  .dropdown-item.active {
    background: var(--accent-soft);
    color: var(--accent-strong);
    font-weight: var(--fw-semibold);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
  }
  .actions :global(.btn) {
    padding: var(--sp-2) var(--sp-4);
    font-size: var(--fs-sm);
  }

  /* Mobile ------------------------------------------------------------- */
  @media (max-width: 920px) {
    .menu-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      margin-inline-start: auto;
      border: 1px solid var(--border-subtle);
      border-radius: var(--r-sm);
      background: var(--surface-1);
      color: var(--text-1);
      cursor: pointer;
    }
    .menu-button:hover {
      background: var(--surface-2);
    }
    .bars {
      position: relative;
      display: inline-block;
      width: 20px;
      height: 14px;
    }
    .bars span {
      position: absolute;
      left: 0;
      right: 0;
      height: 2px;
      background: currentColor;
      border-radius: 2px;
      transition:
        transform var(--dur-fast) var(--ease-out),
        opacity var(--dur-fast) var(--ease-out),
        top var(--dur-fast) var(--ease-out);
    }
    .bars span:nth-child(1) {
      top: 0;
    }
    .bars span:nth-child(2) {
      top: 6px;
    }
    .bars span:nth-child(3) {
      top: 12px;
    }
    .menu-toggle:checked ~ .menu-button .bars span:nth-child(1) {
      top: 6px;
      transform: rotate(45deg);
    }
    .menu-toggle:checked ~ .menu-button .bars span:nth-child(2) {
      opacity: 0;
    }
    .menu-toggle:checked ~ .menu-button .bars span:nth-child(3) {
      top: 6px;
      transform: rotate(-45deg);
    }

    .drawer {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: var(--sp-2);
      padding: var(--sp-3) var(--sp-4) var(--sp-4);
      background: var(--surface-1);
      border-bottom: 1px solid var(--border-subtle);
      box-shadow: var(--shadow-lg);
      display: none;
    }
    .menu-toggle:checked ~ .drawer {
      display: flex;
    }
    .nav {
      display: flex;
      flex-direction: column;
      gap: 2px;
      margin: 0;
    }
    .nav-link {
      padding: var(--sp-3);
      font-size: var(--fs-base);
    }
    /* In the mobile drawer the sub-menu is always visible under Políticos.  */
    .dropdown {
      display: flex;
      flex-direction: column;
    }
    .dropdown-menu {
      display: flex;
      position: static;
      box-shadow: none;
      border: none;
      background: transparent;
      padding: 0 0 0 var(--sp-4);
    }
    .caret {
      display: none;
    }
    .actions {
      flex-direction: row;
      gap: var(--sp-2);
      padding-top: var(--sp-2);
      border-top: 1px solid var(--border-subtle);
      flex-wrap: wrap;
    }
    .actions :global(.btn) {
      flex: 1;
      justify-content: center;
    }
  }
</style>

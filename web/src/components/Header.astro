---
// Site header — collapses into a hamburger drawer on small screens. Consumes
// semantic tokens (--surface-*/--text-*/--accent) so it Just Works in dark
// mode. Political nav only; social/fediverse lives inside AuthMenu.
import AuthMenu from './islands/AuthMenu.svelte';
import BrandLine from './BrandLine.astro';

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);

// Header é só o nível 1. As páginas de /politicos/* têm sua própria sub-nav
// dentro (PoliticosTabs) com Diretório · Gasto · Propostas dos Mandatos.
const links: Array<{ href: string; label: string; cta?: boolean }> = [
  { href: '/politicos/', label: 'Políticos' },
  { href: '/partidos', label: 'Partidos' },
  { href: '/eleicoes/2026', label: 'Eleições 2026' },
  { href: '/propostas', label: 'Propostas' },
  { href: '/propor', label: 'Propor', cta: true },
  { href: '/debates', label: 'Debates' },
  { href: '/consultas', label: 'Consultas' },
  { href: '/servicos', label: 'Serviços' },
];
---

<header class="site-header">
  <div class="container bar">
    <a href="/" class="brand" aria-label="DemocraciaBR — página inicial">
      <BrandLine size={30} />
    </a>

    <input id="menu-toggle" class="menu-toggle" type="checkbox" aria-hidden="true" />
    <label for="menu-toggle" class="menu-button" aria-label="Abrir menu">
      <span class="bars" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
      </span>
    </label>

    <div class="drawer">
      <nav aria-label="Navegação principal" class="nav">
        {
          links.map((l) => (
            <a
              href={l.href}
              class:list={[
                'nav-link',
                { active: isActive(l.href), cta: l.cta },
              ]}
              aria-current={isActive(l.href) ? 'page' : undefined}
            >
              {l.label}
            </a>
          ))
        }
      </nav>

      <div class="actions">
        <AuthMenu client:load />
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    background: var(--surface-1);
    border-bottom: 1px solid var(--border-subtle);
    position: sticky;
    top: 0;
    z-index: 50;
    transition: background var(--dur-base) var(--ease-out);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
    min-height: 64px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }

  .menu-toggle,
  .menu-button {
    display: none;
  }

  .drawer {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
    flex: 1;
    justify-content: space-between;
  }
  .nav {
    display: flex;
    align-items: center;
    gap: 2px;
    flex-wrap: nowrap;
    margin-inline-start: auto;
  }
  .nav-link {
    display: inline-block;
    text-decoration: none;
    color: var(--text-2);
    font-weight: var(--fw-medium);
    padding: var(--sp-2) var(--sp-2);
    border-radius: var(--r-sm);
    font-size: var(--fs-sm);
    line-height: 1.2;
    white-space: nowrap;
    transition:
      background var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }
  .nav-link:hover {
    background: var(--surface-2);
    color: var(--text-1);
  }
  .nav-link.active {
    color: var(--accent-strong);
    background: var(--accent-soft);
  }
  .nav-link.cta {
    background: var(--accent);
    color: var(--accent-contrast);
  }
  .nav-link.cta:hover {
    background: var(--accent-strong);
    color: var(--accent-contrast);
    filter: brightness(1.05);
  }
  .nav-link.cta.active {
    background: var(--accent-strong);
    color: var(--accent-contrast);
    box-shadow:
      inset 0 0 0 2px var(--surface-1),
      0 0 0 2px var(--accent-strong);
  }
  .actions {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
  }
  .actions :global(.btn) {
    padding: var(--sp-2) var(--sp-4);
    font-size: var(--fs-sm);
    white-space: nowrap;
  }

  /* Desktop apertado: entre 1024 e 1199 o ThemeToggle vira icon-only pra
     deixar espaço pros 7 itens da nav caberem em uma linha só. */
  @media (max-width: 1199px) and (min-width: 1024px) {
    .actions :global(.lbl) {
      display: none;
    }
  }

  /* Mobile / tablet ---------------------------------------------------- */
  @media (max-width: 1023px) {
    .menu-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      margin-inline-start: auto;
      border: 1px solid var(--border-subtle);
      border-radius: var(--r-sm);
      background: var(--surface-1);
      color: var(--text-1);
      cursor: pointer;
    }
    .menu-button:hover {
      background: var(--surface-2);
    }
    .bars {
      position: relative;
      display: inline-block;
      width: 20px;
      height: 14px;
    }
    .bars span {
      position: absolute;
      left: 0;
      right: 0;
      height: 2px;
      background: currentColor;
      border-radius: 2px;
      transition:
        transform var(--dur-fast) var(--ease-out),
        opacity var(--dur-fast) var(--ease-out),
        top var(--dur-fast) var(--ease-out);
    }
    .bars span:nth-child(1) {
      top: 0;
    }
    .bars span:nth-child(2) {
      top: 6px;
    }
    .bars span:nth-child(3) {
      top: 12px;
    }
    .menu-toggle:checked ~ .menu-button .bars span:nth-child(1) {
      top: 6px;
      transform: rotate(45deg);
    }
    .menu-toggle:checked ~ .menu-button .bars span:nth-child(2) {
      opacity: 0;
    }
    .menu-toggle:checked ~ .menu-button .bars span:nth-child(3) {
      top: 6px;
      transform: rotate(-45deg);
    }

    .drawer {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: var(--sp-2);
      padding: var(--sp-3) var(--sp-4) var(--sp-4);
      background: var(--surface-1);
      border-bottom: 1px solid var(--border-subtle);
      box-shadow: var(--shadow-lg);
      display: none;
    }
    .menu-toggle:checked ~ .drawer {
      display: flex;
    }
    .nav {
      display: flex;
      flex-direction: column;
      gap: 2px;
      margin: 0;
    }
    .nav-link {
      padding: var(--sp-3);
      font-size: var(--fs-base);
    }
    .actions {
      flex-direction: row;
      gap: var(--sp-2);
      padding-top: var(--sp-2);
      border-top: 1px solid var(--border-subtle);
      flex-wrap: wrap;
    }
    .actions :global(.btn) {
      flex: 1;
      justify-content: center;
    }
  }
</style>

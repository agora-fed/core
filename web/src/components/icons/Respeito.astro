---
// Respeito — shield with check (brand green by default via currentColor).
interface Props {
  size?: number;
  class?: string;
  title?: string;
}
const { size = 28, class: className, title } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.9"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
>
  {title && <title>{title}</title>}
  <path d="M12 3 5 5.7V11c0 4.3 2.9 7.4 7 8.8 4.1-1.4 7-4.5 7-8.8V5.7Z"></path>
  <path d="m8.8 11.8 2.2 2.2 4.2-4.2"></path>
</svg>

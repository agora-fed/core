---
// Acordos — handshake (brand amber by default via currentColor).
interface Props {
  size?: number;
  class?: string;
  title?: string;
}
const { size = 28, class: className, title } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.9"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
>
  {title && <title>{title}</title>}
  <path d="m11 18 1.6 1.6a1.4 1.4 0 0 0 2-2"></path>
  <path
    d="m13.5 16 2.4 2.4a1.4 1.4 0 0 0 2-2l-3.7-3.7a2.1 2.1 0 0 0-3 0l-.6.6a1.4 1.4 0 0 1-2-2l2.4-2.4a4.5 4.5 0 0 1 5.4-.7l.3.2a1.5 1.5 0 0 0 1 .2L21 8"
  ></path>
  <path d="M3 8.5 6 5.5l3.5 1.4"></path>
  <path d="m3 8.5 5 5a1.4 1.4 0 0 0 2-2"></path>
</svg>

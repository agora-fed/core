---
// Participação — group of people (brand red by default via currentColor).
interface Props {
  size?: number;
  class?: string;
  title?: string;
}
const { size = 28, class: className, title } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.9"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
>
  {title && <title>{title}</title>}
  <path d="M16 20v-1.5a3.5 3.5 0 0 0-3.5-3.5h-5A3.5 3.5 0 0 0 4 18.5V20"></path>
  <circle cx="10" cy="8" r="3.2"></circle>
  <path d="M20 20v-1.5a3.5 3.5 0 0 0-2.6-3.38"></path>
  <path d="M15.6 5.1a3.2 3.2 0 0 1 0 6"></path>
</svg>

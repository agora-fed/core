---
// Diálogo — friendly rounded speech bubble (brand red by default via currentColor).
interface Props {
  size?: number;
  class?: string;
  title?: string;
}
const { size = 28, class: className, title } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.9"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
>
  {title && <title>{title}</title>}
  <path d="M7.5 18.5 4 21l1-4.2A8 8 0 1 1 12 20a8 8 0 0 1-4.5-1.5Z"></path>
  <path d="M8.5 11h.01M12 11h.01M15.5 11h.01"></path>
</svg>

---
// União — friendly heart (brand green by default via currentColor).
interface Props {
  size?: number;
  class?: string;
  title?: string;
}
const { size = 28, class: className, title } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.9"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
>
  {title && <title>{title}</title>}
  <path
    d="M12 20.5 4.2 13a5 5 0 0 1 7.05-7.05l.75.74.75-.74A5 5 0 0 1 19.8 13Z"
  ></path>
</svg>

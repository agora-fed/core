---
import Dialogo from './icons/Dialogo.astro';
import Transparencia from './icons/Transparencia.astro';
import Participacao from './icons/Participacao.astro';

const year = new Date().getFullYear();
const pillars = [
  {
    Icon: Dialogo,
    name: 'Diálogo',
    color: 'var(--pol-left)',
    text: 'Espaço plural onde diferentes ideias se encontram.',
  },
  {
    Icon: Transparencia,
    name: 'Transparência',
    color: 'var(--pol-right)',
    text: 'Cada resposta — ou silêncio — fica registrado em público.',
  },
  {
    Icon: Participacao,
    name: 'Participação',
    color: 'var(--accent)',
    text: 'Da proposta ao voto, a população no centro da decisão.',
  },
];
---

<footer class="site-footer">
  <div class="container">
    <div class="pillars">
      {
        pillars.map((p) => (
          <div class="pillar">
            <span class="pic" style={`color:${p.color}`} aria-hidden="true">
              <p.Icon size={26} />
            </span>
            <h3>{p.name}</h3>
            <p class="muted">{p.text}</p>
          </div>
        ))
      }
    </div>

    <div class="foot-bar">
      <div class="foot-brand">
        <img src="/logo.png" width="140" height="94" alt="DemocraciaBR" />
        <p class="tagline">Diferentes ideias, um só Brasil.</p>
      </div>
      <nav aria-label="Rodapé" class="foot-nav">
        <a href="/politicos">Políticos</a>
        <a href="/propostas">Propostas</a>
        <a href="/debates">Debates</a>
        <a href="/consultas">Consultas</a>
        <a href="/cadastrar">Criar conta</a>
      </nav>
    </div>

    <p class="copy muted">
      © {year} DemocraciaBR · Infraestrutura democrática soberana, aberta e
      auditável. Participação sem consequência é teatro.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--surface-1);
    border-top: 1px solid var(--border-subtle);
    margin-top: var(--sp-12);
    padding-block: var(--sp-10) var(--sp-6);
    transition: background var(--dur-base) var(--ease-out);
  }
  .pillars {
    display: grid;
    gap: var(--sp-5);
    margin-bottom: var(--sp-8);
  }
  @media (min-width: 720px) {
    .pillars {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .pillar h3 {
    margin: var(--sp-2) 0 var(--sp-1);
    font-size: var(--fs-lg);
    color: var(--text-1);
  }
  .pillar p {
    margin: 0;
    font-size: var(--fs-sm);
    color: var(--text-3);
  }
  .pic {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    border-radius: var(--r-base);
    background: var(--surface-2);
    border: 1px solid var(--border-subtle);
  }
  .foot-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--sp-6);
    flex-wrap: wrap;
    padding-block: var(--sp-5);
    border-top: 1px solid var(--border-subtle);
  }
  .foot-brand img {
    height: 34px;
    width: auto;
  }
  .tagline {
    margin: var(--sp-1) 0 0;
    font-size: var(--fs-sm);
    color: var(--text-3);
  }
  .foot-nav {
    display: flex;
    gap: var(--sp-4);
    flex-wrap: wrap;
  }
  .foot-nav a {
    color: var(--text-2);
    text-decoration: none;
    font-weight: var(--fw-medium);
    font-size: var(--fs-sm);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .foot-nav a:hover {
    color: var(--accent);
  }
  .copy {
    margin: var(--sp-4) 0 0;
    font-size: var(--fs-xs);
  }
</style>

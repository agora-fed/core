---
// Sidebar comum de todas as páginas /admin/*. Recebe o pathname ativo pra
// pintar o item selecionado. Cliente-side leve: o admin já é uma zona
// autenticada e cada seção tem sua própria ilha; o sidebar é só nav estático.
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/admin/' ? path === '/admin/' || path === '/admin' : path.startsWith(href);

const items = [
  { href: '/admin/', label: 'Painel', icon: 'stats' },
  { href: '/admin/denuncias', label: 'Denúncias', icon: 'flag' },
  { href: '/admin/revisoes', label: 'Revisões', icon: 'users' },
  { href: '/admin/usuarios', label: 'Contas', icon: 'users' },
  { href: '/admin/papeis', label: 'Papéis & permissões', icon: 'shield' },
  { href: '/admin/partidos', label: 'Partidos & Diretórios', icon: 'shield' },
  { href: '/admin/base-contatos', label: 'Base de contatos', icon: 'users' },
  { href: '/admin/convites-gabinetes', label: 'Convites aos gabinetes', icon: 'bell' },
  { href: '/admin/completar-perfil', label: 'Completar perfil', icon: 'users' },
  { href: '/admin/contatos-politicos', label: 'Contatos dos políticos', icon: 'users' },
  { href: '/admin/fontes-civicas', label: 'Fontes cívicas (plataformas)', icon: 'globe' },
  { href: '/admin/federacao', label: 'Federação', icon: 'globe' },
  { href: '/admin/email-templates', label: 'Templates de e-mail', icon: 'edit' },
  { href: '/admin/email-domains', label: 'E-mails bloqueados', icon: 'block' },
  { href: '/admin/ip-rules', label: 'Regras de IP', icon: 'block' },
  { href: '/admin/anuncios', label: 'Anúncios', icon: 'bell' },
  { href: '/admin/regras', label: 'Regras', icon: 'shield' },
  { href: '/admin/termos', label: 'Termos', icon: 'edit' },
  { href: '/admin/cw-presets', label: 'CW presets', icon: 'cw' },
  { href: '/admin/hashtags', label: 'Hashtags', icon: 'hashtag' },
  { href: '/admin/emojis', label: 'Emojis', icon: 'upload' },
  { href: '/admin/webhooks', label: 'Webhooks', icon: 'external' },
  { href: '/admin/auditoria', label: 'Auditoria', icon: 'shield' },
];
---

<aside class="admin-sidebar" aria-label="Navegação administrativa">
  <nav>
    <ul>
      {items.map((it) => (
        <li>
          <a
            href={it.href}
            class:list={['sb-link', { active: isActive(it.href) }]}
            aria-current={isActive(it.href) ? 'page' : undefined}
          >
            <span class="sb-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24">
                <use href={`/icons.svg#i-${it.icon}`} />
              </svg>
            </span>
            <span class="sb-label">{it.label}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
</aside>

<style>
  .admin-sidebar {
    background: var(--surface-2);
    border-radius: var(--r-base);
    padding: var(--sp-2);
    align-self: start;
    position: sticky;
    top: 80px;
  }
  .admin-sidebar ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .sb-link {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    padding: var(--sp-2) var(--sp-3);
    border-radius: var(--r-sm);
    text-decoration: none;
    color: var(--text-2);
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    line-height: 1.2;
    transition: background 120ms ease-out, color 120ms ease-out;
  }
  .sb-link:hover {
    background: var(--surface-1);
    color: var(--text-1);
  }
  .sb-link.active {
    background: var(--accent-soft);
    color: var(--accent-strong);
    font-weight: var(--fw-semibold);
  }
  .sb-icon {
    display: inline-flex;
    flex-shrink: 0;
  }
  .sb-icon svg {
    color: currentColor;
  }
  @media (max-width: 900px) {
    .admin-sidebar {
      position: static;
      padding: var(--sp-1);
    }
    .admin-sidebar ul {
      flex-direction: row;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }
    .sb-link {
      white-space: nowrap;
    }
  }
</style>

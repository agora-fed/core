---
// Sala de imprensa (press release + mídia kit), renderizada a partir de um
// PressContent (idioma). Estático — sem JS de cliente. O alternador PT·EN·ES são
// links pras 3 rotas. Downloads apontam pra /press/*.
import ColorBar from './illustrations/ColorBar.astro';
import { PALETTE, type PressContent } from '../lib/press';

interface Props {
  content: PressContent;
}
const { content: c } = Astro.props;

const routes = { pt: '/imprensa', en: '/imprensa/en', es: '/imprensa/es' } as const;
const langs: { code: 'pt' | 'en' | 'es'; name: string }[] = [
  { code: 'pt', name: 'PT' },
  { code: 'en', name: 'EN' },
  { code: 'es', name: 'ES' },
];
const releasePdf = `/press/democraciabr-release-${c.lang}.pdf`;
const zip = '/press/democraciabr-kit-imprensa.zip';

// Callout do Manifesto/Visão — restrito à imprensa (linkado só daqui). Documento
// em português; EN/ES sinalizam o idioma.
const manifesto = {
  pt: { label: 'Manifesto / Visão', desc: 'A tese completa: por que devolver o governo ao povo passa por elevar a capacidade de autogoverno — e como cada peça vira arquitetura.', note: '' },
  en: { label: 'Manifesto / Vision', desc: 'The full thesis: why returning government to the people means raising the capacity for self-rule — and how each piece becomes architecture.', note: ' (em português)' },
  es: { label: 'Manifiesto / Visión', desc: 'La tesis completa: por qué devolver el gobierno al pueblo pasa por elevar la capacidad de autogobierno — y cómo cada pieza se vuelve arquitectura.', note: ' (em português)' },
}[c.lang];
---

<section class="section">
  <div class="container narrow">
    <nav class="langbar" aria-label="Idioma">
      {langs.map((l) => (
        <a href={routes[l.code]} class:list={['lang', { on: l.code === c.lang }]} hreflang={l.code}>{l.name}</a>
      ))}
    </nav>

    <header class="head">
      <ColorBar class="head-bar" />
      <p class="kicker">{c.kicker}</p>
      <h1>{c.headline}</h1>
    </header>

    <article class="prose release">
      <p class="lede"><strong>{c.lede}</strong></p>
      {c.body.map((p) => <p>{p}</p>)}
      <blockquote>“{c.quote}”<cite>— {c.quoteAttribution}</cite></blockquote>
      <p class="closing"><a href="https://democracia.social.br">{c.closing}</a></p>
      <p class="release-dl">
        <a class="btn" href={releasePdf} download>{c.dl.releasePdf}</a>
      </p>
    </article>

    <a class="manifesto-cta" href="/imprensa/manifesto">
      <span class="mc-label">{manifesto.label}<span class="mc-note">{manifesto.note}</span> →</span>
      <span class="mc-desc">{manifesto.desc}</span>
    </a>

    <hr class="rule" />

    <!-- Mídia kit -->
    <h2 class="mk-title">{c.mediaKitHeading}</h2>
    <p class="muted">{c.mediaKitIntro}</p>

    <h3>{c.brandHeading}</h3>
    <div class="logo-box">
      <img src="/logo.png" alt="DemocraciaBR" width="320" height="auto" />
    </div>

    <h3>{c.paletteHeading}</h3>
    <ul class="palette">
      {PALETTE.map((p) => (
        <li>
          <span class="swatch" style={`background:${p.hex}`}></span>
          <span class="sw-name">{p.name}</span>
          <code>{p.hex}</code>
        </li>
      ))}
    </ul>

    <h3>{c.typographyHeading}</h3>
    <p class="type-sample">Aa Bb Cc — DemocraciaBR</p>
    <p class="muted small">{c.typographyText}</p>

    <h3>{c.downloadsHeading}</h3>
    <div class="downloads">
      <a class="btn" href="/press/democraciabr-logo.png" download>{c.dl.logo}</a>
      <a class="btn" href="/emblem.png" download>{c.dl.emblem}</a>
      <a class="btn" href="/og-image.png" download>{c.dl.og}</a>
      <a class="btn" href="/press/democraciabr-identity-manual.png" download>{c.dl.manual}</a>
      <a class="btn" href={releasePdf} download>{c.dl.releasePdf}</a>
      <a class="btn btn-primary" href={zip} download>{c.dl.zip}</a>
    </div>

    <hr class="rule" />

    <!-- Boilerplate + fact sheet -->
    <h2>{c.boilerplateHeading}</h2>
    <p>{c.boilerplateShort}</p>
    <p class="muted">{c.boilerplateLong}</p>

    <h2>{c.factSheetHeading}</h2>
    <dl class="facts">
      {c.facts.map((f) => (
        <div class="fact">
          <dt>{f.label}</dt>
          <dd>{f.value}</dd>
        </div>
      ))}
    </dl>

    <hr class="rule" />

    <!-- Contato -->
    <h2>{c.contactHeading}</h2>
    <p>{c.contactText}</p>
    <p><a class="btn btn-primary" href="/contato/?setor=imprensa">{c.contactCta}</a></p>
  </div>
</section>

<style>
  .narrow { max-width: 46rem; }
  .langbar { display: flex; gap: var(--sp-1); justify-content: flex-end; margin-bottom: var(--sp-3); }
  .lang { font-size: var(--fs-sm); font-weight: var(--fw-semibold); padding: 2px 10px; border-radius: 999px; text-decoration: none; color: var(--text-3); border: 1px solid var(--border-subtle); }
  .lang.on { color: #fff; background: var(--accent); border-color: var(--accent); }
  .head { margin-bottom: var(--sp-5); }
  .head-bar { margin-bottom: var(--sp-3); }
  .kicker { text-transform: uppercase; letter-spacing: 0.08em; font-size: var(--fs-xs); font-weight: var(--fw-semibold); color: var(--accent-strong); margin: 0 0 var(--sp-2); }
  h1 { margin: 0; line-height: 1.15; }
  .prose p, .prose ul, .prose ol, .prose dd { line-height: var(--lh-relaxed); color: var(--text-2); }
  .release .lede { font-size: var(--fs-lg); color: var(--text-1); }
  .release blockquote { border-left: 3px solid var(--accent); margin: var(--sp-4) 0; padding: var(--sp-1) var(--sp-4); font-size: var(--fs-lg); color: var(--text-1); }
  .release blockquote cite { display: block; margin-top: var(--sp-2); font-size: var(--fs-sm); font-style: normal; color: var(--text-3); }
  .closing a { color: var(--accent-strong); font-weight: var(--fw-semibold); }
  .release-dl { margin-top: var(--sp-4); }
  .manifesto-cta { display: block; margin-top: var(--sp-5); padding: var(--sp-4); border: 1px solid var(--border-subtle); border-left: 3px solid var(--accent); border-radius: var(--r-md); background: var(--surface-2); text-decoration: none; }
  .manifesto-cta:hover { border-color: var(--accent); }
  .mc-label { display: block; font-weight: var(--fw-semibold); color: var(--accent-strong); margin-bottom: 4px; }
  .mc-note { font-weight: var(--fw-regular); color: var(--text-3); }
  .mc-desc { display: block; font-size: var(--fs-sm); color: var(--text-2); line-height: var(--lh-relaxed); }
  .rule { border: none; border-top: 1px solid var(--border-subtle); margin: var(--sp-6) 0; }
  .mk-title, h2 { color: var(--text-1); }
  h3 { color: var(--text-1); margin: var(--sp-5) 0 var(--sp-2); font-size: var(--fs-md); }
  .logo-box { background: var(--surface-2); border: 1px solid var(--border-subtle); border-radius: var(--r-md); padding: var(--sp-5); display: grid; place-items: center; }
  .logo-box img { max-width: 100%; height: auto; }
  .palette { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr)); gap: var(--sp-3); }
  .palette li { display: flex; flex-direction: column; gap: 4px; }
  .swatch { height: 3rem; border-radius: var(--r-sm); border: 1px solid rgba(0,0,0,.08); }
  .sw-name { font-weight: var(--fw-semibold); font-size: var(--fs-sm); }
  .palette code { font-size: var(--fs-xs); color: var(--text-3); }
  .type-sample { font-weight: 700; font-size: 2rem; margin: 0; color: var(--text-1); }
  .small { font-size: var(--fs-sm); }
  .downloads { display: flex; flex-wrap: wrap; gap: var(--sp-2); }
  .btn { display: inline-block; padding: var(--sp-2) var(--sp-4); border-radius: var(--r-sm); border: 1px solid var(--border-subtle); background: var(--surface-1); color: var(--text-1); text-decoration: none; font-size: var(--fs-sm); font-weight: var(--fw-semibold); }
  .btn:hover { border-color: var(--accent); }
  .btn-primary { background: var(--accent); color: #fff; border-color: var(--accent); }
  .facts { display: grid; gap: 0; margin: var(--sp-2) 0 0; }
  .fact { display: grid; grid-template-columns: 12rem 1fr; gap: var(--sp-3); padding: var(--sp-3) 0; border-top: 1px solid var(--border-subtle); }
  .fact:last-child { border-bottom: 1px solid var(--border-subtle); }
  .fact dt { font-weight: var(--fw-semibold); color: var(--text-1); }
  .fact dd { margin: 0; }
  @media (max-width: 560px) { .fact { grid-template-columns: 1fr; gap: 2px; } }
  /* PDF: só o material editorial; esconde nav de idioma e botões de download. */
  @media print {
    .langbar, .downloads, .release-dl, .manifesto-cta { display: none !important; }
    .rule { margin: 1.2rem 0; }
    h1 { font-size: 1.6rem; }
  }
</style>

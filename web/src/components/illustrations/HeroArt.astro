---
// App-like hero illustration: a phone mockup showing a mini scorecard + live
// SLA pill, set against soft brand-color blobs. Pure CSS/SVG, no raster.
import Emblem from './Emblem.astro';
---

<div class="hero-art" aria-hidden="true">
  <!-- soft brand blobs -->
  <svg class="blobs" viewBox="0 0 400 440" preserveAspectRatio="xMidYMid meet">
    <defs>
      <radialGradient id="bg-green" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#15803d" stop-opacity="0.18"></stop>
        <stop offset="100%" stop-color="#15803d" stop-opacity="0"></stop>
      </radialGradient>
      <radialGradient id="bg-blue" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#1d4ed8" stop-opacity="0.16"></stop>
        <stop offset="100%" stop-color="#1d4ed8" stop-opacity="0"></stop>
      </radialGradient>
      <radialGradient id="bg-amber" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#f4c20d" stop-opacity="0.22"></stop>
        <stop offset="100%" stop-color="#f4c20d" stop-opacity="0"></stop>
      </radialGradient>
    </defs>
    <circle cx="120" cy="120" r="120" fill="url(#bg-green)"></circle>
    <circle cx="320" cy="150" r="110" fill="url(#bg-blue)"></circle>
    <circle cx="200" cy="380" r="130" fill="url(#bg-amber)"></circle>
  </svg>

  <!-- phone -->
  <div class="phone">
    <div class="screen">
      <div class="app-top">
        <Emblem size={40} />
        <span class="app-name">DemocraciaBR</span>
      </div>

      <div class="mini-card sla">
        <span class="dot"></span>
        <div>
          <p class="lbl">Prazo correndo</p>
          <p class="time">23<small>h</small> 41<small>min</small></p>
        </div>
      </div>

      <div class="mini-card prop">
        <p class="prop-t">Mais creches no bairro</p>
        <div class="bar"><span style="width:72%"></span></div>
        <p class="prop-m">1.284 apoios · 72% da meta</p>
      </div>

      <div class="fake-btn">Apoiar</div>
    </div>
  </div>
</div>

<style>
  .hero-art {
    position: relative;
    width: 100%;
    max-width: 420px;
    margin-inline: auto;
    aspect-ratio: 1 / 1.05;
  }
  .blobs {
    position: absolute;
    inset: -6% -8%;
    width: 116%;
    height: 112%;
  }
  .phone {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%) rotate(-3deg);
    width: 62%;
    aspect-ratio: 9 / 18;
    background: #0f172a;
    border-radius: 30px;
    padding: 9px;
    box-shadow:
      0 18px 40px rgba(15, 23, 42, 0.22),
      0 4px 10px rgba(15, 23, 42, 0.12);
  }
  .screen {
    height: 100%;
    background: linear-gradient(180deg, #ffffff, #f2f4f7);
    border-radius: 22px;
    padding: 14px 12px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    overflow: hidden;
  }
  .app-top {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .app-name {
    font-weight: 700;
    font-size: 0.82rem;
    color: var(--c-navy);
  }
  .mini-card {
    background: #fff;
    border: 1px solid var(--c-border);
    border-radius: 12px;
    padding: 10px;
    box-shadow: 0 2px 6px rgba(15, 23, 42, 0.05);
  }
  .sla {
    display: flex;
    align-items: center;
    gap: 9px;
    background: #fff7ed;
    border-color: #fde6c8;
  }
  .sla .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #c2410c;
    flex: none;
    animation: blink 1.6s ease-in-out infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0.35;
    }
  }
  .lbl {
    margin: 0;
    font-size: 0.62rem;
    font-weight: 700;
    color: #c2410c;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .time {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--c-navy);
    font-variant-numeric: tabular-nums;
  }
  .time small {
    font-size: 0.6rem;
    color: var(--c-text-muted);
    font-weight: 600;
  }
  .prop-t {
    margin: 0 0 7px;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--c-navy);
  }
  .bar {
    height: 7px;
    background: #e7ecf2;
    border-radius: 999px;
    overflow: hidden;
  }
  .bar span {
    display: block;
    height: 100%;
    background: var(--c-green);
  }
  .prop-m {
    margin: 6px 0 0;
    font-size: 0.62rem;
    color: var(--c-text-muted);
  }
  .fake-btn {
    margin-top: auto;
    text-align: center;
    background: var(--c-green);
    color: #fff;
    font-weight: 700;
    font-size: 0.82rem;
    padding: 9px;
    border-radius: 999px;
  }
  @media (prefers-reduced-motion: reduce) {
    .sla .dot {
      animation: none;
    }
  }
</style>

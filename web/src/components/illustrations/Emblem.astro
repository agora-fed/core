---
// The DemocraciaBR emblem — three people (red, amber, blue) embraced by a green
// ring. Cropped from the official logo (brand/democraciabr-logo.png) so the
// mark on screen is identical to the brand asset.
interface Props {
  size?: number;
  class?: string;
  title?: string;
}
const { size = 120, class: className, title = 'DemocraciaBR' } = Astro.props;
// Source asset is 340x316 — keep the intrinsic aspect ratio.
const height = Math.round(size * (316 / 340));
---

<img
  src="/emblem.png"
  width={size}
  height={height}
  alt={title}
  class={className}
  decoding="async"
/>

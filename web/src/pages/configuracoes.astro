---
import BaseLayout from '../layouts/BaseLayout.astro';
import ColorBar from '../components/illustrations/ColorBar.astro';
import SettingsShell from '../components/islands/SettingsShell.svelte';

const description =
  'Ajuste seu perfil, o tema visual, sua senha, os aplicativos conectados e busque perfis no fediverso.';
---

<BaseLayout title="Configurações" {description} noindex>
  <section class="section">
    <div class="container settings">
      <header class="head">
        <ColorBar class="head-bar" />
        <h1>Configurações</h1>
        <p class="muted lede">
          Tudo o que é sua conta. As mudanças ficam salvas assim que você
          confirma em cada aba.
        </p>
      </header>

      <SettingsShell client:load />
    </div>
  </section>
</BaseLayout>

<style>
  .settings {
    max-width: 48rem;
  }
  .head {
    margin-bottom: var(--sp-6);
  }
  .head-bar {
    margin-bottom: var(--sp-3);
  }
  h1 {
    margin: 0 0 var(--sp-2);
  }
  .lede {
    font-size: var(--fs-lg);
  }
</style>

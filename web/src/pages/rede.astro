---
import BaseLayout from '../layouts/BaseLayout.astro';
import ColorBar from '../components/illustrations/ColorBar.astro';
import SocialConnections from '../components/islands/SocialConnections.svelte';

const description =
  'Sua rede na DemocraciaBR — quem você segue e quem te segue.';
---

<BaseLayout title="Minha rede" {description} noindex>
  <section class="section">
    <div class="container">
      <header class="head">
        <ColorBar class="head-bar" />
        <h1>Minha rede</h1>
        <p class="muted lede">
          Duas listas: quem você segue e quem te segue. Clique em qualquer
          handle pra abrir o perfil aqui dentro da DemocraciaBR.
        </p>
      </header>
      <SocialConnections client:load />
    </div>
  </section>
</BaseLayout>

<style>
  .container {
    max-width: 60rem;
  }
  .head {
    margin-bottom: var(--sp-6);
  }
  .lede {
    max-width: 42rem;
  }
</style>

---
// Painel de gerenciamento de doações/financiamento de campanha (0.31).
// Exclusivo de contas com vínculo de mandato — o gate mora no servidor
// (GET /me/campanha → is_politico) e a entrada fica no submenu do perfil.
// noindex: painel privado, como o painel-mandato.
import BaseLayout from '../../layouts/BaseLayout.astro';
import DoacoesPainel from '../../components/islands/DoacoesPainel.svelte';

const description =
  'Painel de doações e financiamento de campanha da DemocraciaBR.';
---

<BaseLayout title="Doações e financiamento" {description} noindex>
  <section class="section">
    <div class="container narrow">
      <DoacoesPainel client:load />
    </div>
  </section>
</BaseLayout>

<style>
  .narrow {
    max-width: 52rem;
  }
</style>

---
// Página individual da proposta. SSG: uma página por proposta existente no build, mas o
// conteúdo (apoios, SLA, comentários) é CARREGADO CLIENT-SIDE pela ilha — assim a contagem
// reflete em tempo real e novas propostas aparecem no próximo rebuild (em vez de 404).
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProposalDetail from '../../components/islands/ProposalDetail.svelte';
import { getProposals, DEFAULT_ORG_ID } from '../../lib/api';

export async function getStaticPaths() {
  const res = await getProposals(DEFAULT_ORG_ID, 500);
  if (!res.ok || !res.data) return [];
  return res.data.map((p) => ({ params: { id: p.id } }));
}

const { id } = Astro.params;
const description =
  'Demanda pública dirigida a um parlamentar — apoie, comente, acompanhe o prazo de resposta.';
---

<BaseLayout title="Demanda pública" {description} noindex>
  <section class="section">
    <div class="container">
      <ProposalDetail client:load proposalId={id!} />
    </div>
  </section>
</BaseLayout>

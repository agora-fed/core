---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProposeForm from '../../components/islands/ProposeForm.svelte';
import { getProposals, DEFAULT_ORG_ID } from '../../lib/api';
import { formatDate } from '../../lib/format';

const proposals = await getProposals(DEFAULT_ORG_ID, 30);
const items = proposals.ok && proposals.data ? proposals.data : [];

const description =
  'Propostas cívicas direcionadas a mandatos e candidaturas. Apoie, debata e acompanhe quais cruzaram o limiar e iniciaram o prazo de resposta.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Propostas · DemocraciaBR',
  inLanguage: 'pt-BR',
  description,
};
---

<BaseLayout title="Propostas" {description} {jsonLd}>
  <section class="section">
    <div class="container">
      <header class="page-head">
        <h1>Propostas</h1>
        <p class="muted lede">
          Ideias direcionadas a um mandato. Ao reunir apoios suficientes, uma
          proposta cruza o limiar e dispara o relógio do prazo.
        </p>
      </header>

      {
        !proposals.ok && (
          <div class="card state" role="alert">
            <h2>Não foi possível carregar as propostas</h2>
            <p class="muted">{proposals.error}</p>
          </div>
        )
      }

      {
        proposals.ok && items.length === 0 && (
          <div class="card state">
            <h2>Seja o primeiro a propor</h2>
            <p class="muted">
              Ainda não há propostas publicadas. Use o formulário abaixo para
              começar.
            </p>
          </div>
        )
      }

      {
        items.length > 0 && (
          <ul class="list grid grid-2">
            {items.map((p) => (
              <li class="card prop">
                <a class="prop-link" href={`/propostas/${p.id}`}>
                  <h2 class="prop-title">{p.title}</h2>
                  <p class="prop-body muted">{p.body}</p>
                  <div class="prop-foot">
                    <span class="support">
                      <strong>{p.support_count.toLocaleString('pt-BR')}</strong>{' '}
                      {p.support_count === 1 ? 'apoio' : 'apoios'}
                    </span>
                    <time datetime={p.created_at} class="muted">
                      {formatDate(p.created_at)}
                    </time>
                  </div>
                </a>
              </li>
            ))}
          </ul>
        )
      }

      <section class="propose-block" aria-labelledby="propose-h">
        <h2 id="propose-h">Enviar uma nova proposta</h2>
        <p class="muted">
          Direcione sua proposta a um mandato específico. É preciso estar
          autenticado.
        </p>
        <div class="card form-card">
          <ProposeForm client:visible />
        </div>
      </section>
    </div>
  </section>
</BaseLayout>

<style>
  .page-head {
    max-width: 46rem;
    margin-bottom: 2rem;
  }
  .lede {
    font-size: 1.1rem;
  }
  .list {
    list-style: none;
    padding: 0;
    margin: 0 0 3rem;
  }
  .prop {
    padding: 0;
  }
  .prop-link {
    display: block;
    padding: 1.25rem;
    text-decoration: none;
    color: inherit;
  }
  .prop-link:hover {
    background: var(--c-bg);
  }
  .prop-title {
    font-size: 1.15rem;
    margin: 0 0 0.4rem;
  }
  .prop-body {
    margin: 0 0 1rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .prop-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.9rem;
  }
  .support strong {
    color: var(--c-green-dark);
    font-size: 1.05rem;
  }
  .propose-block {
    max-width: 46rem;
  }
  .form-card {
    margin-top: 1rem;
  }
  .state {
    text-align: center;
    padding: 3rem 1.5rem;
    margin-bottom: 2rem;
  }
</style>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ConsultasList from '../../components/islands/ConsultasList.svelte';
import CreateConsultaForm from '../../components/islands/CreateConsultaForm.svelte';

const description =
  'Consultas públicas da DemocraciaBR: a população é ouvida diretamente sobre as decisões que afetam o seu dia a dia.';
---

<BaseLayout title="Consultas públicas" {description}>
  <section class="section">
    <div class="container">
      <header class="page-head">
        <h1>Consultas públicas</h1>
        <p class="muted lede">
          Perguntas abertas à população. Você responde concordo, neutro ou
          discordo — e cada resposta é um sinal direto para quem decide.
        </p>
      </header>

      <CreateConsultaForm client:load />
      <ConsultasList client:load />
    </div>
  </section>
</BaseLayout>

<style>
  .page-head {
    max-width: 46rem;
    margin-bottom: 2rem;
  }
  .lede {
    font-size: 1.1rem;
  }
</style>

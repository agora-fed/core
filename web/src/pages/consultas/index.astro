---
import { SITE_NAME } from '../../lib/site';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ConsultasList from '../../components/islands/ConsultasList.svelte';
import CreateConsultaForm from '../../components/islands/CreateConsultaForm.svelte';

const description =
  `Consultas públicas da ${SITE_NAME}: enquetes abertas e federadas — escolha uma opção e participe.`;
---

<BaseLayout title="Consultas públicas" {description}>
  <section class="section">
    <div class="container">
      <header class="page-head">
        <h1>Consultas públicas</h1>
        <p class="muted lede">
          Enquetes abertas à população. Escolha uma opção e participe —
          visível também no fediverso.
        </p>
      </header>

      <CreateConsultaForm fixedKind="consulta" client:load />
      <ConsultasList kind="consulta" client:load />
    </div>
  </section>
</BaseLayout>

<style>
  .page-head {
    max-width: 46rem;
    margin-bottom: 2rem;
  }
  .lede {
    font-size: 1.1rem;
  }
</style>

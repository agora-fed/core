---
// /admin/federacao — bloqueios de domínio server-wide.
import BaseLayout from '../../layouts/BaseLayout.astro';
import ColorBar from '../../components/illustrations/ColorBar.astro';
import AdminFederation from '../../components/islands/AdminFederation.svelte';

const description =
  'Política de federação da instância: quais domínios remotos estão silenciados ou suspensos.';
---

<BaseLayout title="Federação" {description} noindex>
  <section class="section">
    <div class="container">
      <header class="head">
        <ColorBar class="head-bar" />
        <h1>Federação</h1>
        <p class="muted lede">
          Bloqueios de domínio aplicados pela instância inteira. Diferente do
          bloqueio pessoal de cada cidadão (menu 3-pontinhos), este define a
          política que vale para todos.
        </p>
      </header>
      <AdminFederation client:load />
    </div>
  </section>
</BaseLayout>

<style>
  .container {
    max-width: 72rem;
  }
  .head {
    margin-bottom: 2rem;
  }
  .lede {
    max-width: 42rem;
  }
</style>

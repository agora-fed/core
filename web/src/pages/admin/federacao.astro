---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminFederation from '../../components/islands/AdminFederation.svelte';
---

<AdminLayout
  title="Federação (admin)"
  description="Política de federação da instância: quais domínios remotos estão silenciados ou suspensos."
>
  <header class="head">
    <h1>Federação</h1>
    <p class="muted">
      Bloqueios de domínio aplicados pela instância inteira. Diferente do
      bloqueio pessoal de cada cidadão (menu 3-pontinhos), este define a
      política que vale para todos.
    </p>
  </header>
  <AdminFederation client:load />
</AdminLayout>

<style>
  .head {
    margin-bottom: var(--sp-5);
  }
  h1 {
    margin: 0 0 var(--sp-1);
  }
</style>

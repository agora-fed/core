---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminReports from '../../components/islands/AdminReports.svelte';
---

<AdminLayout
  title="Denúncias"
  description="Fila de denúncias submetidas por cidadãos, aguardando avaliação da moderação."
>
  <header class="head">
    <h1>Denúncias</h1>
    <p class="muted">
      Publicações denunciadas por cidadãos. Você pode ver o conteúdo,
      registrar notas e marcar como resolvida.
    </p>
  </header>
  <AdminReports client:load />
</AdminLayout>

<style>
  .head {
    margin-bottom: var(--sp-5);
  }
  h1 {
    margin: 0 0 var(--sp-1);
  }
</style>

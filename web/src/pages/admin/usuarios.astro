---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminUsersPage from '../../components/islands/AdminUsersPage.svelte';
---

<AdminLayout
  title="Contas (admin)"
  description="Gerenciamento completo de contas: busca, filtros por partido/papel/tipo cívico, edição e ações de moderação."
>
  <header class="head">
    <h1>Contas</h1>
    <p class="muted">
      Busca, filtros por partido/papel/tipo cívico + drawer com edição e
      ações de moderação (suspender, silenciar).
    </p>
  </header>
  <AdminUsersPage client:load />
</AdminLayout>

<style>
  .head {
    margin-bottom: var(--sp-5);
  }
  h1 {
    margin: 0 0 var(--sp-1);
  }
</style>

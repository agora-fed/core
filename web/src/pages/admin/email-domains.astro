---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminEmailDomains from '../../components/islands/AdminEmailDomains.svelte';
---

<AdminLayout
  title="Domínios de e-mail bloqueados (admin)"
  description="E-mails com esses domínios não podem se cadastrar na instância."
>
  <header class="head">
    <h1>Domínios de e-mail bloqueados</h1>
    <p class="muted">
      Cadastros com e-mail terminando nesses domínios são recusados. Útil
      pra bloquear serviços de e-mail descartável.
    </p>
  </header>
  <AdminEmailDomains client:load />
</AdminLayout>

<style>
  .head { margin-bottom: var(--sp-5); }
  h1 { margin: 0 0 var(--sp-1); }
</style>

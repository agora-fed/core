---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminModulesPanel from '../../components/islands/AdminModulesPanel.svelte';
---

<AdminLayout title="Módulos (admin)" description="Ative os recursos que esta instância usa.">
  <header class="head">
    <h1>Módulos</h1>
    <p class="muted">Escolha os recursos disponíveis para a comunidade.</p>
  </header>
  <AdminModulesPanel client:load />
</AdminLayout>

<style>
  .head {
    margin-bottom: var(--sp-5);
  }
  h1 {
    margin: 0 0 var(--sp-1);
  }
</style>

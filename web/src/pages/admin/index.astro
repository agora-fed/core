---
// /admin/ agora é só o Painel de métricas. Cada seção admin virou página
// própria (denúncias, usuários, federação, auditoria) linkada pelo
// AdminSidebar comum.
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminDashboard from '../../components/islands/AdminDashboard.svelte';
---

<AdminLayout
  title="Painel"
  description="Painel de métricas da instância DemocraciaBR."
>
  <header class="head">
    <h1>Painel</h1>
    <p class="muted">
      Métricas operacionais da instância. Use o menu à esquerda pra ir
      pras áreas de moderação e admin.
    </p>
  </header>
  <AdminDashboard client:load />
</AdminLayout>

<style>
  .head {
    margin-bottom: var(--sp-5);
  }
  h1 {
    margin: 0 0 var(--sp-1);
  }
</style>

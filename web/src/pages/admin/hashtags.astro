---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminHashtags from '../../components/islands/AdminHashtags.svelte';
---

<AdminLayout
  title="Hashtags (admin)"
  description="Bane hashtags do trending/feed público ou promova as que devem sempre aparecer."
>
  <header class="head">
    <h1>Moderação de hashtags</h1>
    <p class="muted">
      <strong>Banida</strong>: some do trending e do feed público (posts
      individuais ainda existem). <strong>Promovida</strong>: aparece no
      trending mesmo sem volume.
    </p>
  </header>
  <AdminHashtags client:load />
</AdminLayout>

<style>
  .head { margin-bottom: var(--sp-5); }
  h1 { margin: 0 0 var(--sp-1); }
</style>

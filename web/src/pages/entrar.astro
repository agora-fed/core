---
import BaseLayout from '../layouts/BaseLayout.astro';
import LoginForm from '../components/islands/LoginForm.svelte';

const description =
  'Entre na sua conta DemocraciaBR para apoiar propostas, comentar e cobrar respostas dos mandatos.';
---

<BaseLayout title="Entrar" {description} noindex>
  <section class="section">
    <div class="container auth-shell">
      <div class="auth-card card">
        <img
          src="/logo.png"
          width="180"
          height="120"
          alt="DemocraciaBR"
          class="logo"
        />
        <h1>Entrar</h1>
        <p class="muted">Bem-vindo de volta. Sua voz, com consequência.</p>
        <LoginForm client:load />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .auth-shell {
    max-width: 26rem;
  }
  .auth-card {
    padding: 2rem;
  }
  .logo {
    height: 44px;
    width: auto;
    display: block;
    margin-bottom: 1rem;
  }
  h1 {
    margin-bottom: 0.25rem;
  }
  .auth-card > .muted {
    margin-bottom: 1.5rem;
  }
</style>

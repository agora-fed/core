---
// Aceite de convite de parlamentar (rota query-param). Sob SSG puro (ADR-0009) é a única
// rota viável — tokens são credenciais secretas e não podem ser pré-geradas em `getStaticPaths`.
// O e-mail enviado pelo backend (`mandate_invite::send`) monta este link como
// `${PUBLIC_WEB_BASE}/convite?token=<t>`. A ilha lê o token da querystring.
//
// Quando um adapter SSR for adotado, o gêmeo dinâmico `convite/[token].astro` passa a atender
// `/convite/<token>` sem mudança de ilha (que já lê os dois formatos).
import BaseLayout from '../layouts/BaseLayout.astro';
import AcceptMandateInvite from '../components/islands/AcceptMandateInvite.svelte';

const description =
  'Aceite o convite para assumir o mandato na plataforma DemocraciaBR.';
---

<BaseLayout title="Aceitar convite" {description} noindex>
  <section class="section">
    <div class="container auth-shell">
      <div class="auth-card card">
        <img
          src="/logo.png"
          width="180"
          height="120"
          alt="DemocraciaBR"
          class="logo"
        />
        <h1>Aceitar convite</h1>
        <p class="muted">
          Você foi convidado(a) a assumir um mandato na plataforma cidadã de
          cobrança pública.
        </p>
        <AcceptMandateInvite client:load />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .auth-shell {
    max-width: 30rem;
  }
  .auth-card {
    padding: 2rem;
  }
  .logo {
    height: 44px;
    width: auto;
    display: block;
    margin-bottom: 1rem;
  }
  h1 {
    margin-bottom: 0.25rem;
  }
  .auth-card > .muted {
    margin-bottom: 1.5rem;
  }
</style>

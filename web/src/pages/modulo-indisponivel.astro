---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Recurso indisponível"
  description="Este recurso não está disponível nesta instância."
  noindex
>
  <section class="section">
    <div class="container narrow">
      <h1>Este recurso não está disponível aqui</h1>
      <p class="muted">A administração desta instância não ativou o módulo desta página.</p>
      <a class="btn btn-primary" href="/">Voltar ao início</a>
    </div>
  </section>
</BaseLayout>

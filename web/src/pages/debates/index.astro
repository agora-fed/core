---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getDebates, DEFAULT_ORG_ID } from '../../lib/api';
import { formatDate } from '../../lib/format';

const debates = await getDebates(DEFAULT_ORG_ID, 30);
const items = debates.ok && debates.data ? debates.data : [];

const description =
  'Debates abertos da DemocraciaBR: espaços plurais onde diferentes ideias se encontram e qualificam as demandas da população.';
---

<BaseLayout title="Debates" {description}>
  <section class="section">
    <div class="container">
      <header class="page-head">
        <h1>Debates</h1>
        <p class="muted lede">
          Diferentes ideias, um só Brasil. O espaço plural onde os argumentos
          amadurecem antes de virar cobrança.
        </p>
      </header>

      {
        !debates.ok && (
          <div class="card state" role="alert">
            <h2>Não foi possível carregar os debates</h2>
            <p class="muted">{debates.error}</p>
          </div>
        )
      }

      {
        debates.ok && items.length === 0 && (
          <div class="card state">
            <h2>Nenhum debate em aberto</h2>
            <p class="muted">Novos debates aparecerão aqui assim que abertos.</p>
          </div>
        )
      }

      {
        items.length > 0 && (
          <ul class="list grid grid-2">
            {items.map((d) => (
              <li class="card item">
                <h2 class="item-title">{d.title}</h2>
                {d.body && <p class="muted clamp">{d.body}</p>}
                {d.created_at && (
                  <time datetime={d.created_at} class="muted small">
                    {formatDate(d.created_at)}
                  </time>
                )}
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .page-head {
    max-width: 46rem;
    margin-bottom: 2rem;
  }
  .lede {
    font-size: 1.1rem;
  }
  .list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .item-title {
    font-size: 1.15rem;
    margin: 0 0 0.4rem;
  }
  .clamp {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .small {
    font-size: 0.85rem;
  }
  .state {
    text-align: center;
    padding: 3rem 1.5rem;
  }
</style>

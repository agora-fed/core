---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CreateDebateForm from '../../components/islands/CreateDebateForm.svelte';
import DebatesList from '../../components/islands/DebatesList.svelte';

const description =
  'Debates abertos da DemocraciaBR: espaços plurais onde diferentes ideias se encontram e qualificam as demandas da população.';
---

<BaseLayout title="Debates" {description}>
  <section class="section">
    <div class="container">
      <header class="page-head">
        <h1>Debates</h1>
        <p class="muted lede">
          Diferentes ideias, um só Brasil. O espaço plural onde os argumentos
          amadurecem antes de virar cobrança.
        </p>
      </header>

      <CreateDebateForm client:load />
      <DebatesList client:load />
    </div>
  </section>
</BaseLayout>

<style>
  .page-head {
    max-width: 46rem;
    margin-bottom: 2rem;
  }
  .lede {
    font-size: 1.1rem;
  }
</style>

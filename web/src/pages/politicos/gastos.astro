---
// Painel de gastos parlamentares — Câmara open data agregado por
// (partido | político | casa | esfera | UF | cargo). Sub-menu de Políticos.
import BaseLayout from '../../layouts/BaseLayout.astro';
import GastoParlamentarDashboard from '../../components/islands/GastoParlamentarDashboard.svelte';

const description =
  'Painel de gastos parlamentares (cota da Câmara) agregado por partido, político, casa, esfera, estado e cargo.';
---

<BaseLayout title="Gasto Parlamentar" {description}>
  <section class="section">
    <div class="container narrow">
      <GastoParlamentarDashboard client:load />
    </div>
  </section>
</BaseLayout>

<style>
  .narrow {
    max-width: 60rem;
  }
</style>

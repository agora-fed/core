---
// Painel de gastos parlamentares FEDERAL — CEAP (Câmara) + CEAPS (Senado)
// agregado por partido, político, casa, UF ou cargo. Estadual/municipal não
// têm fonte pública unificada equivalente — ver comentário no island.
import BaseLayout from '../../layouts/BaseLayout.astro';
import GastoParlamentarDashboard from '../../components/islands/GastoParlamentarDashboard.svelte';

const description =
  'Painel de gastos parlamentares federais — CEAP (Câmara) + CEAPS (Senado) — agregados por partido, político, casa, estado e cargo.';
---

<BaseLayout title="Gasto Parlamentar" {description}>
  <section class="section">
    <div class="container narrow">
      <GastoParlamentarDashboard client:load />
    </div>
  </section>
</BaseLayout>

<style>
  .narrow {
    max-width: 60rem;
  }
</style>

---
// Diretório de parlamentares — CSR (ilha Svelte) pra a lista refletir mudanças em prod sem
// rebuild. O backend tem 100+ deputados reais (PT/PCdoB/PSOL/PV/Rede da Câmara + 9 senadores
// PT do Senado), e a esposa quer filtrar por partido/casa e ver as fotos oficiais. SSG não
// dava conta: cada novo seed exigia novo deploy.
import BaseLayout from '../../layouts/BaseLayout.astro';
import ColorBar from '../../components/illustrations/ColorBar.astro';
import PoliticosTabs from '../../components/PoliticosTabs.astro';
import PoliticosPage from '../../components/islands/PoliticosPage.svelte';

const description =
  'Diretório completo de mandatos no Brasil — Câmara Federal, Senado, Assembleias Legislativas, Prefeituras e Câmaras Municipais. Filtre por esfera, estado e município.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Placar dos políticos · DemocraciaBR',
  inLanguage: 'pt-BR',
  description,
};
---

<BaseLayout title="Placar dos políticos" {description} {jsonLd}>
  <section class="section">
    <div class="container">
      <header class="page-head">
        <ColorBar class="head-bar" />
        <h1>Placar dos políticos</h1>
        <p class="muted lede">
          Todos os mandatos do Brasil: Câmara Federal, Senado, Assembleias
          Legislativas, Prefeituras e Câmaras Municipais. Escolha
          <strong>nível → estado → município</strong> pra ver quem é quem.
        </p>
      </header>
      <PoliticosTabs />
      <PoliticosPage client:load />
    </div>
  </section>
</BaseLayout>

<style>
  .page-head {
    max-width: 46rem;
    margin-bottom: 2rem;
  }
  .head-bar {
    margin-bottom: 0.9rem;
  }
  .lede {
    font-size: 1.05rem;
  }
</style>

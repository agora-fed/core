---
// Página individual do parlamentar. SSG: pré-gera uma página por mandato existente AT
// build-time (todos os ~107 parlamentares hoje), mas o conteúdo dinâmico (scorecard, propostas,
// SLAs correndo) é CARREGADO CLIENT-SIDE pela ilha — assim a página reflete mudanças sem
// rebuild. SSR seria mais limpo mas exigiria um adapter (ADR-0009 manda SSG por ora).
import BaseLayout from '../../layouts/BaseLayout.astro';
import MandateDetail from '../../components/islands/MandateDetail.svelte';
import { getAllMandates, DEFAULT_ORG_ID } from '../../lib/api';

export async function getStaticPaths() {
  // 0.23.0-municipais: pré-gera apenas mandatos federais + estaduais (~1.7k
  // páginas). Gerar SSG para os ~68k municipais explodiria o build (9+ min) e
  // o tamanho da imagem (~400 MB de HTMLs). Municipais são acessados pela rota
  // fallback /politicos/?id=X — a mesma ilha MandateDetail hidrata o perfil.
  const [fed, est] = await Promise.all([
    getAllMandates(DEFAULT_ORG_ID, 5000, 'federal'),
    getAllMandates(DEFAULT_ORG_ID, 5000, 'estadual'),
  ]);
  const merged = [
    ...(fed.ok && fed.data ? fed.data : []),
    ...(est.ok && est.data ? est.data : []),
  ];
  return merged.map((m) => ({ params: { mandate: m.id } }));
}

const { mandate } = Astro.params;
const description =
  'Perfil público do(a) parlamentar — demandas dirigidas, tempo de resposta, prazos correndo.';
---

<BaseLayout title="Parlamentar" {description} noindex>
  <section class="section">
    <div class="container">
      <MandateDetail client:load mandateId={mandate!} />
    </div>
  </section>
</BaseLayout>

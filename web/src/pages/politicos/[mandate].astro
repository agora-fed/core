---
// Página individual do parlamentar. SSG: pré-gera uma página por mandato existente AT
// build-time (todos os ~107 parlamentares hoje), mas o conteúdo dinâmico (scorecard, propostas,
// SLAs correndo) é CARREGADO CLIENT-SIDE pela ilha — assim a página reflete mudanças sem
// rebuild. SSR seria mais limpo mas exigiria um adapter (ADR-0009 manda SSG por ora).
import BaseLayout from '../../layouts/BaseLayout.astro';
import MandateDetail from '../../components/islands/MandateDetail.svelte';
import { getMandates, DEFAULT_ORG_ID } from '../../lib/api';

export async function getStaticPaths() {
  // Puxa TODOS os mandatos no build — não os com scorecard, como era antes (que dava 404 pra
  // 95% dos políticos seedados sem demandas ainda).
  const res = await getMandates(DEFAULT_ORG_ID, 500);
  if (!res.ok || !res.data) return [];
  return res.data.map((m) => ({ params: { mandate: m.id } }));
}

const { mandate } = Astro.params;
const description =
  'Perfil público do(a) parlamentar — demandas dirigidas, tempo de resposta, prazos correndo.';
---

<BaseLayout title="Parlamentar" {description} noindex>
  <section class="section">
    <div class="container">
      <MandateDetail client:load mandateId={mandate!} />
    </div>
  </section>
</BaseLayout>

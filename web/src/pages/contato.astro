---
import BaseLayout from '../layouts/BaseLayout.astro';
import ColorBar from '../components/illustrations/ColorBar.astro';
import ContactForm from '../components/islands/ContactForm.svelte';

const description =
  'Fale com a DemocraciaBR: dúvidas gerais, privacidade (LGPD), moderação e segurança — um único formulário, sem expor e-mails.';
---

<BaseLayout title="Contato" {description}>
  <section class="section">
    <div class="container narrow">
      <header class="head">
        <ColorBar class="head-bar" />
        <h1>Contato</h1>
        <p class="lede muted">
          Um único canal para falar com a equipe — escolha o setor e
          responderemos no e-mail que você informar.
        </p>
      </header>
      <ContactForm client:load />
    </div>
  </section>
</BaseLayout>

<style>
  .narrow {
    max-width: 32rem;
  }
  .head {
    margin-bottom: var(--sp-6);
  }
  .head-bar {
    margin-bottom: var(--sp-3);
  }
  h1 {
    margin: 0 0 var(--sp-2);
  }
  .lede {
    font-size: var(--fs-lg);
    line-height: var(--lh-relaxed);
  }
</style>

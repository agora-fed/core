---
import BaseLayout from '../layouts/BaseLayout.astro';
import BrandLine from '../components/BrandLine.astro';
import RegisterForm from '../components/islands/RegisterForm.svelte';

const description =
  'Crie sua conta DemocraciaBR com e-mail, senha e CPF e participe da cobrança pública aos mandatos.';
---

<BaseLayout title="Criar conta" {description} noindex>
  <section class="section">
    <div class="container auth-shell">
      <div class="auth-card card">
        <BrandLine size={34} class="logo" />
        <h1>Criar conta</h1>
        <p class="muted">
          Participe da plataforma onde a demanda popular vira responsabilidade
          pública.
        </p>
        <RegisterForm client:load />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .auth-shell {
    max-width: 26rem;
  }
  .auth-card {
    padding: 2rem;
  }
  .logo {
    height: 44px;
    width: auto;
    display: block;
    margin-bottom: 1rem;
  }
  h1 {
    margin-bottom: 0.25rem;
  }
  .auth-card > .muted {
    margin-bottom: 1.5rem;
  }
</style>

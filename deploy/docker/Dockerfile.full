# Self-contained multi-stage build: compiles the gateway (SQLX_OFFLINE against the
# committed .sqlx/ cache) and the Astro web bundle inside the image, so CI (GitHub
# Actions → GHCR) and the docker-compose "tosqueira" need NOTHING pre-built on the
# host. The slim deploy/docker/Dockerfile (binary staged from outside) remains the
# fast path for the sovereign park where the release binary is built on the host.

# ---- Stage 1: Rust gateway -----------------------------------------------------
FROM rust:1.94-trixie AS backend
WORKDIR /src
COPY . .
ENV SQLX_OFFLINE=true CARGO_TERM_COLOR=always
RUN cargo build --release -p dsoc-gateway

# ---- Stage 2: Astro web bundle -------------------------------------------------
FROM node:22-trixie-slim AS web
WORKDIR /src/web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
ARG PUBLIC_API_BASE="https://democracia.social.br"
ENV PUBLIC_API_BASE=${PUBLIC_API_BASE}
# Identity of the release image. Other instances override these with --build-arg.
ARG SITE="https://democracia.social.br"
ARG PUBLIC_SITE_NAME="DemocraciaBR"
ARG PUBLIC_SITE_NAME_ACCENT="BR"
ARG PUBLIC_SITE_MOTTO="Participação sem consequência é teatro."
ARG PUBLIC_ANALYTICS_DOMAIN="democracia.social.br"
ARG PUBLIC_ANALYTICS_URL="https://analytics.pop.coop/js/script.file-downloads.hash.outbound-links.pageview-props.revenue.tagged-events.js"
ENV SITE=${SITE} PUBLIC_SITE_NAME=${PUBLIC_SITE_NAME} PUBLIC_SITE_NAME_ACCENT=${PUBLIC_SITE_NAME_ACCENT} PUBLIC_SITE_MOTTO="${PUBLIC_SITE_MOTTO}" PUBLIC_ANALYTICS_DOMAIN=${PUBLIC_ANALYTICS_DOMAIN} PUBLIC_ANALYTICS_URL=${PUBLIC_ANALYTICS_URL}
RUN npm run build

# ---- Stage 3: runtime (mirrors deploy/docker/Dockerfile) ------------------------
FROM debian:trixie-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates \
 && rm -rf /var/lib/apt/lists/*
RUN useradd --system --uid 10001 --no-create-home --shell /usr/sbin/nologin dsoc
USER 10001:10001
COPY --from=backend --chown=10001:10001 /src/target/release/dsoc-gateway /usr/local/bin/dsoc-gateway
COPY --from=web --chown=10001:10001 /src/web/dist /srv/web
ENV WEB_ROOT=/srv/web GATEWAY_PORT=8080 RUST_LOG=info
ARG RUNTIME_SITE_NAME="DemocraciaBR"
ARG RUNTIME_ORIGIN="https://democracia.social.br"
ENV PUBLIC_SITE_NAME=${RUNTIME_SITE_NAME} PUBLIC_ORIGIN=${RUNTIME_ORIGIN}
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/dsoc-gateway"]

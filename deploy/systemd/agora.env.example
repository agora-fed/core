# AGORA — systemd deployment environment
# Copy to /opt/agora/etc/agora.env and fill in. NEVER commit real values.
# PLAN.md principle 8 — secrets only here.

# --- Database (IPv6-first; PLAN.md principle 4) ---
DATABASE_URL=postgres://agora:CHANGE_ME@[::1]:5432/agora

# --- Public identity (set before first boot — ActivityPub actor IDs are permanent) ---
PUBLIC_ORIGIN=https://agora.organica.social
PUBLIC_HOST=agora.organica.social
PUBLIC_WEB_BASE=https://agora.organica.social

# --- Gateway ---
GATEWAY_PORT=8080
WEB_ROOT=/srv/web
RUST_LOG=info,dsoc_gateway=debug

# --- Localization (ISO-3166-1 alpha-2; only BR implemented) ---
INSTALL_L10N=BR

# --- PII encryption (generate once with: openssl rand -base64 32) ---
PII_ENCRYPTION_KEY=

# --- Web Push (VAPID keys; generate with: npx web-push generate-vapid-keys) ---
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:admin@organica.social

# --- Respond link secret (generate with: openssl rand -hex 32) ---
RESPOND_LINK_SECRET=

# --- Intercoms config encryption key (generate with: openssl rand -base64 32) ---
INTERCOMS_CONFIG_KEY=

# --- SMTP (optional; without SMTP_HOST the service logs instead of sending) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=AGORA <sistema@organica.social>

# --- Public petitions (module.initiatives) — see docs/petitions.md ---
# Without ALTCHA_HMAC_KEY only signed-in members can sign.
ALTCHA_HMAC_KEY=
# Who sends the confirmation e-mail: local (this server, needs SMTP_*) or sso (the identity provider).
PETITIONS_EMAIL_VERIFICATION=local
# Create accounts at the identity provider: none or zitadel. Required by the sso mode.
PETITIONS_SSO_PROVISIONING=none
# Service user with the Org User Manager role only. API and org default to SSO_ISSUER / SSO_ALLOWED_ORG_ID.
PETITIONS_SSO_TOKEN=
#PETITIONS_SSO_API=
#PETITIONS_SSO_ORG_ID=
# Optional: URL prefix; the username is appended and only HTTP 404 means it is free.
#PETITIONS_HANDLE_CHECK_URL=https://mastodon.example.org/api/v1/accounts/lookup?acct=
#PETITIONS_PENDING_TTL_HOURS=72
#PETITIONS_RESEND_COOLDOWN_SECS=300
#PETITIONS_MAX_EMAILS_PER_HOUR=200

# --- Object storage (optional; without STORAGE_* uploads return 503) ---
# STORAGE_ENDPOINT=http://[::1]:9000
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_BUCKET=agora-media
# STORAGE_REGION=us-east-1

# --- OIDC (optional; without these, only local auth works) ---
# AUTH_OIDC_ISSUER=
# AUTH_OIDC_AUDIENCE=
# AUTH_OIDC_JWKS_URL=

# --- Worker (consequence SLA loop; disable for cooperative-only installs) ---
WORKER_ENABLED=false

# --- Consensus embedder (skip for small installs) ---
# CONSENSUS_EMBEDDER=model
# CONSENSUS_MODEL_DIR=/opt/agora/models/sentence-transformers

# --- Contact form inbox ---
CONTACT_INBOX=contato@organica.social

# --- Rate limits ---
RATE_LIMIT_WRITES_PER_MIN=30
AUTH_LOGIN_RATE_MAX_PER_HOUR=30
AUTH_SIGNUP_RATE_MAX_PER_HOUR=10

[Unit]
Description=AGORA database migrations (oneshot)
Documentation=https://github.com/agora-fed/core
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/opt/agora/etc/agora.env
ExecStart=/opt/agora/bin/agora-migrate
WorkingDirectory=/opt/agora
TimeoutStartSec=120

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

StandardOutput=journal
StandardError=journal
SyslogIdentifier=agora-migrate

[Install]
WantedBy=multi-user.target

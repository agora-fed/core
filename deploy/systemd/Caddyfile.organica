# AGORA — Orgânica Social reverse proxy
# Automatic HTTPS (Let's Encrypt over IPv6).
# The gateway serves BOTH the static site and /api/v1 (no CORS needed).
agora.organica.social {
	encode zstd gzip

	# Hashed Astro assets are immutable — cache hard.
	@assets path /_astro/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# HTML must revalidate so a new deploy is picked up immediately.
	@nocache {
		not path /_astro/*
		not path /api/*
	}
	header @nocache Cache-Control "no-cache"

	reverse_proxy [::1]:8080 {
		# SECURITY: strip identity-injection headers (the gateway also strips them
		# defensively in inject_identity, but defense in depth).
		header_up -X-Dsoc-Citizen-Id
		header_up -X-Dsoc-Org-Id
		header_up -X-Citizen-Id
	}
}
